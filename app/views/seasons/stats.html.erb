<% header_cell = ->(label, sort_type, extra_classes = "") do %>
  <% capture do %>
    <th
      scope="col"
      class="
        px-6 py-3 font-medium cursor-pointer hover:bg-neutral-secondary
        <%= extra_classes %>
      "
      data-sort-type="<%= sort_type %>"
    >
      <div class="flex items-center gap-1">
        <%= label %>
        <svg
          class="w-[18px] h-[18px] text-gray-800 dark:text-white"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            fill-rule="evenodd"
            d="M12.832 3.445a1 1 0 0 0-1.664 0l-4 6A1 1 0 0 0 8 11h8a1 1 0 0 0 .832-1.555l-4-6Zm-1.664 17.11a1 1 0 0 0 1.664 0l4-6A1 1 0 0 0 16 13H8a1 1 0 0 0-.832 1.555l4 6Z"
            clip-rule="evenodd"
          />
        </svg>
      </div>
    </th>
  <% end %>
<% end %>

<div class="flex flex-col gap-3 p-5 items-center">
  <h1 class="font-bold text-4xl">
    <%= @season.season %>
    Stats
  </h1>
  <div
    class="
      relative overflow-x-auto bg-neutral-primary shadow-xs rounded-xl border
      border-default
    "
  >
    <table class="w-full text-sm text-left text-heading" id="stats-table">
      <thead
        class="
          text-xs text-heading uppercase border-b border-default select-none
        "
      >
        <tr>
          <%= header_cell.call("Name", "text", "bg-neutral-secondary-soft") %>
          <%= header_cell.call("PA", "number") %>
          <%= header_cell.call("AB", "number", "bg-neutral-secondary-soft") %>
          <%= header_cell.call("H", "number") %>
          <%= header_cell.call("AVG", "number", "bg-neutral-secondary-soft") %>
          <%= header_cell.call("RBIs", "number") %>
          <%= header_cell.call("Runs", "number", "bg-neutral-secondary-soft") %>
          <%= header_cell.call("HR", "number") %>
          <%= header_cell.call("OBP", "number", "bg-neutral-secondary-soft") %>
          <%= header_cell.call("SLG", "number") %>
          <%= header_cell.call("OPS", "number", "bg-neutral-secondary-soft") %>
          <%= header_cell.call("Doubles", "number") %>
          <%= header_cell.call("Triples", "number", "bg-neutral-secondary-soft") %>
          <%= header_cell.call("Walks???", "number") %>
        </tr>
      </thead>
      <tbody>
        <% @players.each do |player| %>
          <% abs = @team_abs.where(player_id: player) %>
          <% at_bats = abs.where.not(result: %i[walk hbp sac_fly sac_bunt]).count %>
          <% hits = abs.where(result: %i[single double triple home_run]).count %>
          <% rbis = abs.sum(:rbi) %>
          <% walks = abs.where(result: %i[walk hbp]).count %>
          <% sacs = abs.where(result: %i[sac_fly]).count %>
          <% homeruns = abs.where(result: %i[home_run]).count %>
          <% singles = abs.where(result: %i[single]).count %>
          <% doubles = abs.where(result: %i[double]).count %>
          <% triples = abs.where(result: %i[triple]).count %>
          <% runs = Run.where(plate_appearance_id: abs).count %>

          <%# Floating calculations for correct values %>
          <% avg_val = at_bats > 0 ? hits.to_f / at_bats : 0.0 %>
          <% obp_val = at_bats > 0 ? (hits + walks).to_f / (at_bats + walks + sacs) : 0.0 %>
          <% slg_val =
            (
              if at_bats > 0
                (singles + (2 * doubles) + (3 * triples) + (4 * homeruns)).to_f / at_bats
              else
                0.0
              end
            ) %>
          <% ops_val = obp_val + slg_val %>

          <tr class="border-b border-default hover:bg-neutral-secondary/20">
            <th
              scope="row"
              class="
                px-6 py-4 font-medium whitespace-nowrap bg-neutral-secondary-soft
              "
              data-value="<%= player.name %>"
            >
              <%= player.name %>
              <%= "\u{1f4a9}" if avg_val < 0.3 || ops_val < 1 %>
              <%= "\u{1F525}" if avg_val > 0.55 || ops_val > 2 %>
            </th>
            <td class="px-6 py-4 cursor-pointer" data-value="<%= abs.count %>">
              <%= abs.count %>
            </td>
            <td
              class="
                px-6 py-4 bg-neutral-secondary-soft text-body cursor-pointer
              "
              data-value="<%= at_bats %>"
            >
              <%= at_bats %>
            </td>
            <td class="px-6 py-4 text-body cursor-pointer" data-value="<%= hits %>">
              <%= hits %>
            </td>
            <td
              class="
                px-6 py-4 bg-neutral-secondary-soft text-body cursor-pointer
              "
              data-value="<%= avg_val %>"
            >
              <%= avg_val > 0 ? sprintf("%.3f", avg_val).sub(/\A0/, "") : ".000" %>
            </td>
            <td class="px-6 py-4 text-body cursor-pointer" data-value="<%= rbis %>">
              <%= rbis %>
            </td>
            <td
              class="
                px-6 py-4 bg-neutral-secondary-soft text-body cursor-pointer
              "
              data-value="<%= runs %>"
            >
              <%= runs %>
            </td>
            <td class="px-6 py-4 text-body cursor-pointer" data-value="<%= homeruns %>">
              <%= homeruns %>
            </td>
            <td
              class="
                px-6 py-4 bg-neutral-secondary-soft text-body cursor-pointer
              "
              data-value="<%= obp_val %>"
            >
              <%= obp_val > 0 ? sprintf("%.3f", obp_val).sub(/\A0/, "") : ".000" %>
            </td>
            <td class="px-6 py-4 text-body cursor-pointer" data-value="<%= slg_val %>">
              <%= slg_val > 0 ? sprintf("%.3f", slg_val).sub(/\A0/, "") : ".000" %>
            </td>
            <td
              class="
                px-6 py-4 bg-neutral-secondary-soft text-body cursor-pointer
              "
              data-value="<%= ops_val %>"
            >
              <%= ops_val > 0 ? sprintf("%.3f", ops_val).sub(/\A0/, "") : ".000" %>
            </td>
            <td class="px-6 py-4 text-body cursor-pointer" data-value="<%= doubles %>">
              <%= doubles %>
            </td>
            <td
              class="
                px-6 py-4 bg-neutral-secondary-soft text-body cursor-pointer
              "
              data-value="<%= triples %>"
            >
              <%= triples %>
            </td>
            <td class="px-6 py-4 text-body cursor-pointer" data-value="<%= walks %>">
              <%= walks %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="flex justify-center mt-3">
    <%= link_to "Back",
    season_path(@season),
    class:
      "border-2 border-blue-400 px-4 py-2 rounded-4xl text-blue-500 hover:bg-blue-400 hover:text-white" %>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const table = document.getElementById("stats-table");
    const headers = table.querySelectorAll("thead th");
    const tbody = table.querySelector("tbody");
    
    headers.forEach((header, index) => {
      header.addEventListener("click", () => {
        const rows = Array.from(tbody.querySelectorAll("tr"));
        const sortType = header.getAttribute("data-sort-type");
        const isAscending = header.classList.contains("asc");
        
        // Reset original headers styling
        headers.forEach(h => h.classList.remove("asc", "desc"));
        
        rows.sort((rowA, rowB) => {
          const cellA = rowA.children[index].getAttribute("data-value");
          const cellB = rowB.children[index].getAttribute("data-value");
          
          if (sortType === "number") {
            return isAscending ? parseFloat(cellA) - parseFloat(cellB) : parseFloat(cellB) - parseFloat(cellA);
          } else {
            return isAscending ? cellA.localeCompare(cellB) : cellB.localeCompare(cellA);
          }
        });
        
        if (isAscending) {
          header.classList.add("desc");
        } else {
          header.classList.add("asc");
        }
        
        // Re-append rows in standard sorted order
        rows.forEach(row => tbody.appendChild(row));
      });
    });
  });
</script>
