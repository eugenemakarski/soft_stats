<div class="flex flex-col gap-3 p-5 items-center">
  <h1 class="font-bold text-4xl">
    <%= @season.season %>
    Stats
  </h1>
  <div
    class="
      relative overflow-x-auto bg-neutral-primary shadow-xs rounded-xl border
      border-default
    "
  >
    <table class="w-full text-sm text-left text-heading">
      <thead class="text-sm text-heading border-b border-default">
        <tr>
          <th scope="col" class="px-6 py-3 bg-neutral-secondary-soft font-medium">
            Name
          </th>
          <th scope="col" class="px-6 py-3 font-medium">
            PA
          </th>
          <th scope="col" class="px-6 py-3 bg-neutral-secondary-soft font-medium">
            AB
          </th>
          <th scope="col" class="px-6 py-3 font-medium">
            H
          </th>
          <th scope="col" class="px-6 py-3 bg-neutral-secondary-soft font-medium">
            AVG
          </th>
          <th scope="col" class="px-6 py-3 font-medium">
            RBIs
          </th>
          <th scope="col" class="px-6 py-3 bg-neutral-secondary-soft font-medium">
            Runs
          </th>
          <th scope="col" class="px-6 py-3 font-medium">
            HR
          </th>
          <th scope="col" class="px-6 py-3 bg-neutral-secondary-soft font-medium">
            OBP
          </th>
          <th scope="col" class="px-6 py-3 font-medium">
            SLG
          </th>
          <th scope="col" class="px-6 py-3 bg-neutral-secondary-soft font-medium">
            OPS
          </th>
          <th scope="col" class="px-6 py-3 font-medium">
            Doubles
          </th>
          <th scope="col" class="px-6 py-3 bg-neutral-secondary-soft font-medium">
            Triples
          </th>
          <th scope="col" class="px-6 py-3 font-medium">
            Walks?
          </th>
        </tr>
      </thead>
      <tbody>
        <% @players.each do |player| %>
          <% abs = @team_abs.where(player_id: player) %>
          <% at_bats = abs.where.not(result: %i[walk hbp sac_fly sac_bunt]).count %>
          <% hits = abs.where(result: %i[single double triple homerun]).count %>
          <% rbis = abs.sum(:rbi) %>
          <% walks = abs.where(result: %i[walk hbp]).count %>
          <% sacs = abs.where(result: %i[sac_fly]).count %>
          <% homeruns = abs.where(result: %i[home_run]).count %>
          <% singles = abs.where(result: %i[single]).count %>
          <% doubles = abs.where(result: %i[double]).count %>
          <% triples = abs.where(result: %i[triple]).count %>
          <% obp_num = at_bats > 0 ? (hits + walks).to_f / (at_bats + walks + sacs) : 0.0 %>
          <% slg_num =
            (
              if at_bats > 0
                (singles + (2 * doubles) + (3 * triples) + (4 * homeruns)).to_f / at_bats
              else
                0.0
              end
            ) %>

          <tr class="border-b border-default">
            <th
              scope="row"
              class="
                px-6 py-4 font-medium whitespace-nowrap bg-neutral-secondary-soft
              "
            >
              <%= player.name %>
            </th>
            <td class="px-6 py-4 cursor-pointer">
              <%= abs.count %>
            </td>
            <td class="px-6 py-4 bg-neutral-secondary-soft text-body cursor-pointer">
              <%= at_bats %>
            </td>
            <td class="px-6 py-4 text-body cursor-pointer">
              <%= hits %>
            </td>
            <td class="px-6 py-4 bg-neutral-secondary-soft text-body cursor-pointer">
              <%# AVG %>
              <%= at_bats > 0 ? sprintf("%.3f", hits.to_f / at_bats).sub(/\A0/, "") : ".000" %>
            </td>
            <td class="px-6 py-4 text-body cursor-pointer">
              <%= rbis %>
            </td>
            <td class="px-6 py-4 bg-neutral-secondary-soft text-body cursor-pointer">
              <%= Run.where(plate_appearance_id: abs).count %>
            </td>
            <td class="px-6 py-4 text-body cursor-pointer">
              <%= homeruns %>
            </td>
            <td class="px-6 py-4 bg-neutral-secondary-soft text-body cursor-pointer">
              <%= obp_num > 0 ? sprintf("%.3f", obp_num).sub(/\A0/, "") : ".000" %>
            </td>
            <td class="px-6 py-4 text-body cursor-pointer">
              <%= slg_num > 0 ? sprintf("%.3f", slg_num).sub(/\A0/, "") : ".000" %>
            </td>
            <td class="px-6 py-4 bg-neutral-secondary-soft text-body cursor-pointer">
              <%= if (obp_num + slg_num) > 0
                sprintf("%.3f", obp_num + slg_num).sub(/\A0/, "")
              else
                ".000"
              end %>
            </td>
            <td class="px-6 py-4 text-body cursor-pointer">
              <%= doubles %>
            </td>
            <td class="px-6 py-4 bg-neutral-secondary-soft text-body cursor-pointer">
              <%= triples %>
            </td>
            <td class="px-6 py-4 text-body cursor-pointer">
              <%= walks %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="flex justify-center mt-3">
    <%= link_to "Back",
    season_path(@season),
    class:
      "border-2 border-blue-400 px-4 py-2 rounded-4xl text-blue-500 hover:bg-blue-400 hover:text-white" %>
  </div>
</div>
