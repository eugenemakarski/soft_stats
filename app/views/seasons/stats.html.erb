<div class="flex flex-col gap-4 p-4 md:p-5 w-full max-w-8xl mx-auto">
  <header class="flex flex-col gap-1">
    <h1 class="font-bold text-4xl"><%= @season.team.name %></h1>
    <p class="text-body"><%= @season.season %> season stats</p>
  </header>

  <%# Playoffs live in the same season as the regular schedule; this filter is
      what separates them. %>
  <div class="flex flex-col gap-2">
    <div class="flex flex-wrap gap-2 items-center">
      <%= link_to "All games", stats_season_path(@season), class: chip_class(@game_type.nil?) %>
      <% Game.game_types.keys.each do |type| %>
        <%= link_to Game.game_type_label(type),
        stats_season_path(@season, game_type: type),
        class: chip_class(@game_type == type) %>
      <% end %>
    </div>
    <p class="text-xs text-body-subtle">
      <%= pluralize(@games.size, "game") %>
      in this view
    </p>
  </div>

  <% if @games.empty? %>
    <div class="card">
      <p class="text-body">
        No
        <%= @game_type ? Game.game_type_label(@game_type).downcase : "" %>
        games recorded for
        <%= @season.season %>
        yet.
      </p>
    </div>
  <% else %>
    <section class="flex flex-col gap-2">
      <h2>Batting</h2>
      <%= render "stats/batting_table", stats: @batting_stats %>
    </section>

    <section class="flex flex-col gap-2">
      <h2>Pitching</h2>
      <% if @pitching_stats.empty? %>
        <p class="text-body text-sm">
          No pitching lines yet — a game needs a pitcher on its roster and at
          least one scored half-inning.
        </p>
      <% else %>
        <%= render "stats/pitching_table", stats: @pitching_stats %>
      <% end %>
    </section>
  <% end %>

  <nav class="flex justify-center mt-2">
    <%= link_to "Back to Games", season_path(@season), class: "btn-outline" %>
  </nav>
</div>
