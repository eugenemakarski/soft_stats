<%# Only reached when the team has no seasons; otherwise teams#show redirects
    to the latest season's games. %>
<div class="flex flex-col gap-4 p-4 md:p-5 w-full max-w-md mx-auto">
  <h1 class="font-bold text-4xl"><%= @team.name %></h1>
  <div class="card">
    <p class="text-body">No seasons yet for this team.</p>
    <div class="mt-3">
      <%= link_to "New Season", new_team_season_path(@team), class: "btn-primary" %>
    </div>
  </div>
  <div class="flex justify-center">
    <%= link_to "All Teams", teams_path(all: 1), class: "btn-outline" %>
  </div>
</div>
