<%# app/views/game_rosters/index.html.erb %>
<% players_json = @player_options.map { |p| { id: p.id, name: p.name } } %>
<div class="flex flex-col gap-3 p-5 items-center">
  <h1 class="font-bold text-4xl">Game Roster</h1>

  <% if flash.alert %>
    <p class="error"><%= flash.alert %></p>
  <% end %>

  <div
    data-controller="lineup"
    data-lineup-players-value="<%= players_json.to_json %>"
    class="flex flex-col gap-4 items-center"
  >
    <%= form_with url: game_game_rosters_path(@game), method: :post do %>
      <div class="card w-96 flex flex-col gap-2">
        <h3>Batting Order</h3>

        <div data-lineup-target="rowsContainer" class="flex flex-col gap-2">
          <% if @existing_rosters.present? %>
            <% @existing_rosters.each do |roster| %>
              <%= render "lineup_row", selected_player_id: roster.player_id %>
            <% end %>
          <% else %>
            <% 9.times do %>
              <%= render "lineup_row", selected_player_id: nil %>
            <% end %>
          <% end %>
        </div>

        <template data-lineup-target="rowTemplate">
          <%= render "lineup_row", selected_player_id: nil %>
        </template>

        <button
          type="button"
          data-action="click->lineup#add"
          class="btn-outline self-center mt-1"
        >
          + Add Player
        </button>
      </div>

      <div class="card w-96 flex flex-col gap-2 mt-4">
        <h3>Pitcher</h3>
        <select
          name="pitcher_id"
          class="form-input"
          data-lineup-target="pitcherSelect"
          data-selected="<%= @pitcher_roster&.player_id %>"
          data-action="change->lineup#refresh"
        ></select>
      </div>

      <div class="flex flex-col w-full gap-3 items-center mt-4">
        <%= submit_tag "Save Roster", class: "btn-primary" %>
      </div>
    <% end %>
  </div>

  <%= link_to "Back", game_path(@game), class: "btn-outline mt-2" %>
</div>
