<% cur_inning = game.current_inning
is_home = game.is_home
active_half = game.active_half(cur_inning)
active_half_name = active_half == :fielding ? "fielding" : "batting"
next_player_id = game.next_batter_id
# Viewers see the whole scorebook but none of the controls: `active` is what
# gates the +, the edit chips, "Next Half Inning" and the opponent score form.
can_edit = current_user.can_edit?(game.season.team) %>

<div
  class="flex flex-col gap-4 w-full max-w-4xl mx-auto p-2 md:p-4"
  data-controller="scorebook"
  data-scorebook-inning-value="<%= cur_inning %>"
  data-scorebook-half-value="<%= active_half_name %>"
  data-scorebook-current-inning-value="<%= cur_inning %>"
  data-scorebook-active-half-value="<%= active_half_name %>"
  data-scorebook-game-id-value="<%= game.id %>"
>
  <%# ── Batting / fielding toggle + jump back to the live inning ─── %>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex rounded-full border border-default overflow-hidden">
      <button
        type="button"
        class="segment-button"
        role="tab"
        data-scorebook-target="halfTab"
        data-half="batting"
        data-action="scorebook#selectHalf"
      >
        <%= is_home ? "Bottom" : "Top" %>
        · Batting
      </button>
      <button
        type="button"
        class="segment-button"
        role="tab"
        data-scorebook-target="halfTab"
        data-half="fielding"
        data-action="scorebook#selectHalf"
      >
        <%= is_home ? "Top" : "Bottom" %>
        · Fielding
      </button>
    </div>
    <button type="button" class="btn-outline" data-action="scorebook#goToCurrent">
      ↩ <%= cur_inning.ordinalize %>
    </button>
  </div>

  <%# ── Inning tabs ─────────────────────────────────────────────── %>
  <ul
    class="
      flex flex-nowrap overflow-x-auto text-sm font-medium text-center border-b
      border-default
    "
    data-scorebook-target="inningTablist"
    role="tablist"
  >
    <% (1..9).each do |inn| %>
      <% inn_outs = game.outs(inn, is_home) %>
      <li class="flex-1 min-w-14" role="presentation">
        <button
          id="inning-tab-<%= inn %>"
          type="button"
          role="tab"
          class="tab-button"
          aria-controls="panel-<%= inn %>-batting"
          data-scorebook-target="inningTab"
          data-inning="<%= inn %>"
          data-action="scorebook#selectInning"
        >
          <span class="block"><%= inn.ordinalize %></span>
          <%# Outs are shown for every inning, not just the live one. %>
          <span class="flex justify-center gap-0.5 mt-1">
            <% 3.times do |i| %>
              <span
                class="
                  w-2 h-2 rounded-full <%= i < inn_outs ? 'bg-current' : 'border border-current opacity-40' %>
                "
              ></span>
            <% end %>
          </span>
        </button>
      </li>
    <% end %>
  </ul>

  <%# At-bat forms load in here instead of navigating away from the scorebook. %>
  <%= turbo_frame_tag "pa_form" %>

  <% (1..9).each do |inn| %>
    <% half = inn == cur_inning ? active_half : nil %>
    <%# One panel per (inning, half). The server renders every panel but only
        the live one visible, so there's no flash of all nine innings. %>
    <div
      id="panel-<%= inn %>-batting"
      class="hidden scroll-mt-24"
      role="tabpanel"
      aria-labelledby="inning-tab-<%= inn %>"
      data-scorebook-target="panel"
      data-inning="<%= inn %>"
      data-half="batting"
    >
      <%= render "batting",
      next_player_id: next_player_id,
      inn: inn,
      game: @game,
      active: can_edit && half == :batting %>
    </div>
    <div
      id="panel-<%= inn %>-fielding"
      class="hidden scroll-mt-24"
      role="tabpanel"
      aria-labelledby="inning-tab-<%= inn %>"
      data-scorebook-target="panel"
      data-inning="<%= inn %>"
      data-half="fielding"
    >
      <%= render "fielding", inn: inn, game: @game, active: can_edit && half == :fielding %>
    </div>
  <% end %>

  <%# The 11-column grid needs ~700px, so let it scroll rather than widen the page. %>
  <div class="overflow-x-auto">
    <%= render "score", game: @game %>
  </div>
</div>
