<% fielding_inning_lineup = @fielding.where(inning: inn).order(:position) %>
<% bench =
  @rosters.reject do |p|
    fielding_inning_lineup.map(&:player_id).include?(p.player_id)
  end %>

<div class="flex flex-col gap-2">
  <h2 class="text-center">
    <% if @game.is_home %>
      Top
      <%= inn %>
    <% else %>
      Bottom
      <%= inn %>
    <% end %>
  </h2>

  <div
    id="inning-<%= inn %>"
    class=""
    role="tabpanel"
    aria-labelledby="inning-tab-<%= inn %>"
  >
    <div class="rounded-base border border-default mt-4 overflow-hidden">
      <table class="data-table">
        <thead>
          <tr>
            <th class="w-16">Pos</th>
            <th>Player</th>
          </tr>
        </thead>
        <tbody>
          <% fielding_inning_lineup.each do |f| %>
            <tr>
              <td
                class="
                  inline-block text-xs font-bold px-2 rounded bg-primary/10 text-primary
                "
              >
                <%= f.position %>
              </td>
              <td class="font-medium text-heading"><%= f.player.name %></td>
            </tr>
          <% end %>
          <% if bench.any? %>
            <tr>
              <td
                colspan="2"
                class="
                  text-xs font-bold text-body uppercase tracking-wide px-2 bg-muted/30
                "
              >Bench</td>
            </tr>
            <% bench.each do |p| %>
              <tr class="opacity-60">
                <td class=" inline-block text-xs font-bold px-2 rounded bg-muted text-body ">—</td>
                <td class="font-medium text-heading"><%= p.player.name %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>

    </div>
    <% if active %>
      <div class="p-3 border-t border-default">
        <%= link_to "Input Opponent Score",
        new_game_inning_score_path(game),
        class: "btn-outline" %>
      </div>
    <% end %>

  </div>
</div>
