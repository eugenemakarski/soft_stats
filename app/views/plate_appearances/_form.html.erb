<%# app/views/plate_appearances/_form.html.erb %>
<%= form_with model: plate_appearance.new_record? ? [@game, plate_appearance] : plate_appearance,
data: {
  controller: "pa-form",
  turbo_frame: "_top",
} do |form| %>
  <% if form.object.errors.any? %>
    <p class="text-red-500"><%= form.object.errors.full_messages.first %></p>
  <% end %>

  <%= form.hidden_field :player_id %>
  <%= form.hidden_field :inning %>
  <%= form.hidden_field :top_inning %>
  <%= form.hidden_field :outs_before %>

  <div class="flex flex-col gap-4">
    <div class="form-field">
      <%= form.label :result, class: "form-label" %>
      <%# The select is alphabetical; these are the results that come up most,
          ordered by frequency so the common case stays one tap. %>
      <div class="flex flex-wrap gap-2 mb-2">
        <% PlateAppearance::QUICK_RESULTS.each do |name| %>
          <button
            type="button"
            class="quick-result"
            data-action="pa-form#pick"
            data-pa-form-result-param="<%= name %>"
          ><%= PlateAppearance.result_label(name) %></button>
        <% end %>
      </div>
      <%= form.select :result,
                  PlateAppearance.result_options,
                  { include_blank: "Select result" },
                  class: "form-input",
                  data: {
                    pa_form_target: "resultSelect",
                  } %>
    </div>

    <div class="form-field">
      <%= form.label :rbi, "RBI", class: "form-label" %>
      <%= form.number_field :rbi,
                        min: 0,
                        max: 4,
                        value: plate_appearance.rbi || 0,
                        class: "form-input",
                        data: {
                          pa_form_target: "rbiField",
                          action: "input->pa-form#toggleRunners",
                        } %>
    </div>

    <% if on_base_players.any? %>
      <div
        class="<%= plate_appearance.rbi.to_i > 0 ? '' : 'hidden' %>"
        data-pa-form-target="runnersSection"
      >
        <label class="form-label">
          Who scored?
        </label>
        <div class="flex flex-col gap-1">
          <% on_base_players.each do |player| %>
            <div class="flex items-center gap-2">
              <input
                type="checkbox"
                name="run_scorer_ids[]"
                value="<%= player.id %>"
                id="scorer_<%= player.id %>"
              >
              <label for="scorer_<%= player.id %>"><%= player.name %></label>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= form.submit "Save", class: "btn-primary self-center" %>
  </div>
<% end %>
