<%# app/views/plate_appearances/edit.html.erb %>
<%# Loads into the "pa_form" frame on the scorebook, so recording an at-bat
    doesn't navigate away from the game. %>
<%= turbo_frame_tag "pa_form" do %>
  <div class="card flex flex-col w-full max-w-xl mx-auto">
    <h2>Edit AB</h2>
    <div class="flex flex-col py-3 gap-4">
      <%= render "form",
      plate_appearance: @plate_appearance,
      on_base_players: @on_base_players %>

      <%= link_to "Cancel",
      game_path(@game),
      class: "btn-outline self-center",
      data: {
        turbo_frame: "_top",
      } %>
    </div>
  </div>
<% end %>
